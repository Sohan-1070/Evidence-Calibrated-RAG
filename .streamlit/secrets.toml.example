# ============================================================
# Streamlit Community Cloud Secrets Configuration
# ============================================================
# When deploying to https://share.streamlit.io:
# In your app dashboard, go to Settings -> Secrets and paste the following:

GEMINI_API_KEY = "your_gemini_api_key_here"
ECRAG_GEMINI_MODEL = "gemini-3.5-flash-lite"
ECRAG_OFFLINE = "0"
